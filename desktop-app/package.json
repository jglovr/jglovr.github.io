{
  "name": "jglovr-os-desktop",
  "version": "3.11.0",
  "description": "JGLOVR-OS 3.11 Personal Workstation Standalone Desktop Application with Native Physical Floppy Drive Support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
