<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cody Frog - Mac II Edition</title>
    <style>
        :root {
            --mac-bg: #e6e6e6;
            --mac-border: #000000;
            --mac-dark-grey: #666666;
            --mac-light-grey: #cccccc;
            --mac-blue: #0000aa;
            --mac-green: #008800;
            --mac-red: #cc0000;
            --mac-yellow: #ccaa00;
            --mac-orange: #dd6600;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            font-family: 'Geneva', 'Monaco', 'Courier New', monospace;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #55aaff; /* Classic retro Mac desktop pattern fallback */
            background-image: radial-gradient(#000000 15%, transparent 16%), radial-gradient(#000000 15%, transparent 16%);
            background-size: 4px 4px;
            background-position: 0 0, 2px 2px;
            cursor: default;
        }

        /* Dynamic Full Screen Container */
        #game-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        #canvas-container {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
        }

        #canvas-container canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }

        /* Classic Macintosh UI Panel */
        .ui-panel {
            position: absolute;
            background: var(--mac-bg);
            border: 2px solid var(--mac-border);
            box-shadow: 3px 3px 0px #000000;
            color: #000;
            z-index: 10;
        }

        .mac-titlebar {
            background: repeating-linear-gradient(
                0deg,
                #000 0px, #000 1px,
                #fff 1px, #fff 3px
            );
            height: 18px;
            border-bottom: 2px solid #000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 4px;
            cursor: default;
        }

        .mac-title-text {
            background: var(--mac-bg);
            padding: 0 6px;
            font-weight: bold;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .mac-close-box {
            width: 10px;
            height: 10px;
            background: #fff;
            border: 1px solid #000;
            box-shadow: inset 1px 1px 0 #888;
        }

        /* TOP INVENTORY BAR */
        #inventory-panel {
            top: 12px; 
            left: 12px; 
            right: 12px;
            min-height: 90px;
            display: flex;
            flex-direction: column;
        }

        .panel-body {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 14px;
            flex: 1;
            flex-wrap: wrap;
            gap: 10px;
        }

        #level-badge {
            background: var(--mac-bg);
            border: 2px solid #000;
            box-shadow: 2px 2px 0 #000;
            color: #000;
            padding: 4px 12px;
            font-weight: bold;
            font-size: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        #level-badge:active {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0 #000;
        }

        .inventory { display: flex; gap: 12px; align-items: center; }
        .item {
            width: 64px; height: 64px;
            background: #fff;
            display: flex; justify-content: center; align-items: center;
            cursor: grab;
            border: 2px solid #000;
            box-shadow: 2px 2px 0 #000;
            padding: 4px;
            box-sizing: border-box;
        }
        .item:hover { background: #f0f0f0; }
        .item:active { cursor: grabbing; transform: translate(1px, 1px); box-shadow: 1px 1px 0 #000; }

        /* CENTER-LEFT BUILDER PANEL */
        #arrow-controls-panel {
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            z-index: 15;
        }

        .arrow-panel-content {
            padding: 10px;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 10px;
        }

        .dpad-grid {
            display: grid;
            grid-template-columns: repeat(3, 68px);
            grid-template-rows: repeat(3, 68px);
            gap: 6px;
        }

        .dpad-btn {
            width: 68px;
            height: 68px;
            border: 2px solid #000;
            background: #fff;
            color: black;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 2px 2px 0 #000;
            font-weight: bold;
            font-size: 13px;
        }
        .dpad-btn:active {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0 #000;
        }

        .dpad-btn.btn-up { grid-column: 2; grid-row: 1; background: #99ccff; }
        .dpad-btn.btn-left { grid-column: 1; grid-row: 2; background: #ff9999; }
        .dpad-btn.btn-del { grid-column: 2; grid-row: 2; background: var(--mac-light-grey); }
        .dpad-btn.btn-right { grid-column: 3; grid-row: 2; background: #99ff99; }
        .dpad-btn.btn-down { grid-column: 2; grid-row: 3; background: #ffcc99; }

        .clear-btn-wrapper {
            width: 38px;
            height: 216px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .btn-clear-all {
            width: 216px;
            height: 38px;
            background: #fff;
            border: 2px solid #000;
            color: black;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 1px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            box-shadow: 2px 2px 0 #000;
            transform: rotate(-90deg);
            transform-origin: center;
            flex-shrink: 0;
        }
        .btn-clear-all:active { transform: rotate(-90deg) translate(1px, 1px); box-shadow: 1px 1px 0 #000; }

        /* BOTTOM CODING PANEL */
        #coding-panel {
            bottom: 12px; 
            left: 12px; 
            right: 12px;
            height: 110px;
            display: flex;
            flex-direction: column;
        }

        #card-container {
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 4px 8px;
            flex: 1;
            background: #fff;
            border: 2px solid #000;
            margin: 6px 12px 6px 0;
            height: 72px;
            box-sizing: border-box;
            position: relative;
        }

        .code-card {
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: grab;
            box-shadow: 2px 2px 0 #000;
            user-select: none;
            border: 2px solid #000;
            flex-shrink: 0;
            box-sizing: border-box;
            background: #fff;
        }
        .code-card:active { cursor: grabbing; }
        .code-card.dragging {
            opacity: 0.8;
            z-index: 100;
        }

        .code-card.executing {
            background: #ffff00 !important;
            box-shadow: 0 0 0 3px #000 !important;
            z-index: 50 !important;
        }

        .code-card.card-up { background: #99ccff; }
        .code-card.card-down { background: #ffcc99; }
        .code-card.card-left { background: #ff9999; }
        .code-card.card-right { background: #99ff99; }

        .card-arrow {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .action-side {
            display: flex;
            align-items: center;
            padding: 6px 12px;
        }

        .btn-play {
            width: 72px;
            height: 72px;
            font-size: 15px;
            font-weight: bold;
            border: 2px solid #000;
            background: #99ff99;
            cursor: pointer;
            color: black;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 2px 2px 0 #000;
        }
        .btn-play:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 #000; }

        #status-message {
            width: 80px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #000;
            background: #fff;
            box-shadow: 2px 2px 0 #000;
            font-weight: bold;
            font-size: 12px;
        }

        /* Keyboard Hints Legend */
        #key-legend {
            font-size: 11px;
            font-weight: bold;
            background: #fff;
            border: 1px solid #000;
            padding: 3px 8px;
            letter-spacing: 0px;
        }

        /* Modal Overlays */
        .modal-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.4);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
        }
        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }
        .modal-card {
            background: var(--mac-bg);
            border: 2px solid #000;
            box-shadow: 5px 5px 0px #000;
            padding: 0 0 16px 0;
            text-align: center;
            color: black;
            max-width: 380px;
            width: 85%;
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            margin-top: 14px;
            padding: 0 16px;
        }
        .icon-btn {
            width: 50px;
            height: 50px;
            background: #fff;
            border: 2px solid #000;
            color: #000;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 2px 2px 0 #000;
            font-weight: bold;
        }
        .icon-btn:hover { background: #f0f0f0; }
        .icon-btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 #000; }
        .icon-btn.primary { background: #99ff99; }

        /* Start Menu Modal */
        #start-menu-modal .modal-card { max-width: 340px; }
        #start-menu-modal h1 {
            margin: 16px 0 8px 0;
            font-size: 24px;
            color: #000;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .btn-start-game {
            background: #99ff99;
            color: black;
            border: 2px solid #000;
            padding: 12px 24px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 3px 3px 0 #000;
            width: 80%;
            margin: 12px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .btn-start-game:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 #000; }

        /* Level Grid Modal */
        .level-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            padding: 12px;
        }

        .level-btn {
            background: #fff;
            border: 2px solid #000;
            color: black;
            padding: 8px 0;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 2px 2px 0 #000;
        }
        .level-btn:hover { background: #f0f0f0; }
        .level-btn.active-level { background: #99ff99; }

        .close-modal-btn {
            background: #fff;
            border: 1px solid #000;
            color: #000;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            padding: 2px 6px;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <div id="game-wrapper">
        <div id="canvas-container"></div>

        <div id="inventory-panel" class="ui-panel">
            <div class="mac-titlebar">
                <div class="mac-close-box"></div>
                <div class="mac-title-text">System - Inventory</div>
                <div style="width:10px;"></div>
            </div>
            <div class="panel-body">
                <div id="level-badge" onclick="openLevelSelectModal()" title="Click or Press L to select level">
                    <span>LEVEL</span>
                    <span id="level-number-text">1</span>
                </div>
                <div class="inventory" id="inventory"></div>
                <div id="key-legend">[WASD/Arrows]: Add | [Bksp]: Del | [Space/Enter]: Run</div>
                <div id="status-message"></div>
            </div>
        </div>

        <div id="arrow-controls-panel" class="ui-panel">
            <div class="mac-titlebar">
                <div class="mac-close-box"></div>
                <div class="mac-title-text">Controls</div>
                <div style="width:10px;"></div>
            </div>
            <div class="arrow-panel-content">
                <div class="clear-btn-wrapper">
                    <button class="btn-clear-all" onclick="clearAllCards()">
                        CLEAR [ESC]
                    </button>
                </div>
                <div class="dpad-grid">
                    <button class="dpad-btn btn-up" title="Add UP Card (W / Up Arrow)" onclick="addCard('UP')">▲ UP</button>
                    <button class="dpad-btn btn-left" title="Add LEFT Card (A / Left Arrow)" onclick="addCard('LEFT')">◄ LEFT</button>
                    <button class="dpad-btn btn-del" title="Delete Last Card (Backspace)" onclick="deleteLastCard()">DEL</button>
                    <button class="dpad-btn btn-right" title="Add RIGHT Card (D / Right Arrow)" onclick="addCard('RIGHT')">RIGHT ►</button>
                    <button class="dpad-btn btn-down" title="Add DOWN Card (S / Down Arrow)" onclick="addCard('DOWN')">▼ DOWN</button>
                </div>
            </div>
        </div>

        <div id="coding-panel" class="ui-panel">
            <div class="mac-titlebar">
                <div class="mac-close-box"></div>
                <div class="mac-title-text">Program Sequence</div>
                <div style="width:10px;"></div>
            </div>
            <div style="display: flex; flex: 1; align-items: center;">
                <div class="action-side">
                    <button class="btn-play" title="Run Code (Enter / Space)" onclick="executeCode()">RUN ►</button>
                </div>
                <div id="card-container"></div>
            </div>
        </div>

        <div id="start-menu-modal" class="modal-overlay active">
            <div class="modal-card">
                <div class="mac-titlebar">
                    <div class="mac-close-box"></div>
                    <div class="mac-title-text">Welcome to Macintosh II</div>
                    <div style="width:10px;"></div>
                </div>
                <br>
                <svg width="60" height="60" viewBox="0 0 40 40" fill="none">
                    <rect x="2" y="2" width="36" height="36" fill="#ffffff" stroke="#000000" stroke-width="2"/>
                    <circle cx="12" cy="12" r="5" fill="#00aa00"/>
                    <circle cx="28" cy="12" r="5" fill="#00aa00"/>
                    <circle cx="12" cy="11" r="2" fill="#ffffff"/>
                    <circle cx="28" cy="11" r="2" fill="#ffffff"/>
                    <path d="M8 22 C8 32 32 32 32 22 Z" fill="#008800"/>
                </svg>
                <h1>Cody Frog</h1>
                <p style="font-size: 12px; margin: 0 0 12px 0;">v1.0 - Macintosh System 7</p>
                <button class="btn-start-game" onclick="startGame()">
                    START GAME
                </button>
                <p style="font-size: 11px; color: #555;">[Mouse & Keyboard Edition]</p>
            </div>
        </div>

        <div id="next-level-modal" class="modal-overlay">
            <div class="modal-card">
                <div class="mac-titlebar">
                    <div class="mac-close-box"></div>
                    <div class="mac-title-text">Level Complete!</div>
                    <div style="width:10px;"></div>
                </div>
                <div style="margin-top: 16px;">
                    <svg width="72" height="72" viewBox="0 0 64 64" fill="none">
                        <polygon points="32,4 40,22 58,22 43,33 48,52 32,40 16,52 21,33 6,22 24,22" fill="#ffff00" stroke="#000000" stroke-width="3"/>
                        <polygon points="32,4 32,40 16,52 21,33 6,22 24,22" fill="#ffcc00"/>
                    </svg>
                </div>
                <div class="modal-actions">
                    <button class="icon-btn" title="Select Level" onclick="openLevelSelectModal()">GRID</button>
                    <button class="icon-btn" title="Replay Level (R)" onclick="replayCurrentLevel()">RETRY</button>
                    <button class="icon-btn primary" title="Next Level (Space / Enter)" onclick="loadNextLevel()">NEXT ►</button>
                </div>
            </div>
        </div>

        <div id="level-select-modal" class="modal-overlay">
            <div class="modal-card" style="max-width: 400px;">
                <div class="mac-titlebar">
                    <div class="mac-close-box" onclick="hideLevelSelectModal()"></div>
                    <div class="mac-title-text">Select Level</div>
                    <button class="close-modal-btn" onclick="hideLevelSelectModal()">X</button>
                </div>
                <div class="level-grid" id="level-grid-container"></div>
            </div>
        </div>
    </div>

<script>
    // ==========================================
    // 8-BIT RETRO VECTOR GRAPHICS
    // ==========================================
    const PLANK_SVG = `
        <svg width="80%" height="80%" viewBox="0 0 100 100" fill="none" style="pointer-events:none;">
            <rect x="6" y="6" width="88" height="88" fill="#cc9966" stroke="#000000" stroke-width="3"/>
            <line x1="6" y1="26" x2="94" y2="26" stroke="#000" stroke-width="2"/>
            <line x1="6" y1="50" x2="94" y2="50" stroke="#000" stroke-width="2"/>
            <line x1="6" y1="74" x2="94" y2="74" stroke="#000" stroke-width="2"/>
            <circle cx="16" cy="16" r="3" fill="#000"/>
            <circle cx="84" cy="16" r="3" fill="#000"/>
            <circle cx="16" cy="84" r="3" fill="#000"/>
            <circle cx="84" cy="84" r="3" fill="#000"/>
        </svg>
    `;

    // 8-BIT STONE PLATFORM INVENTORY SVG
    const PLATFORM_SVG = `
        <svg width="80%" height="80%" viewBox="0 0 100 100" fill="none" style="pointer-events:none;">
            <rect x="10" y="20" width="80" height="60" fill="#666666" stroke="#000000" stroke-width="3"/>
            <rect x="18" y="14" width="64" height="52" fill="#aaaaaa" stroke="#000000" stroke-width="2"/>
            <rect x="26" y="22" width="48" height="36" fill="#cccccc" stroke="#000000" stroke-width="1.5"/>
            <line x1="26" y1="22" x2="18" y2="14" stroke="#000000" stroke-width="1.5"/>
            <line x1="74" y1="22" x2="82" y2="14" stroke="#000000" stroke-width="1.5"/>
            <line x1="26" y1="58" x2="18" y2="66" stroke="#000000" stroke-width="1.5"/>
            <line x1="74" y1="58" x2="82" y2="66" stroke="#000000" stroke-width="1.5"/>
        </svg>
    `;

    const STATUS_ICONS = {
        'frog': `FROG`,
        'rocket': `RUN!`,
        'crash': `CRASH`,
        'splash': `SPLASH`,
        'stop': `STOP`,
        'star': `STAR!`,
        'win': `WIN!`
    };

    // ==========================================
    // RETRO MAC AUDIO SYNTHESIZER
    // ==========================================
    let audioCtx = null;

    function initAudio() {
        if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
            audioCtx.resume();
        }
    }

    function playJumpSound() {
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(220, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(660, audioCtx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + 0.1);
    }

    function playBridgeSound() {
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(150, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, audioCtx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + 0.2);
    }

    function playWinSound() {
        if (!audioCtx) return;
        const notes = [261.63, 329.63, 392.00, 523.25];
        notes.forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'square';
            osc.frequency.value = freq;
            const startTime = audioCtx.currentTime + idx * 0.08;
            gain.gain.setValueAtTime(0.15, startTime);
            gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.2);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(startTime);
            osc.stop(startTime + 0.2);
        });
    }

    function playTrophySound() {
        if (!audioCtx) return;
        const notes = [440, 554.37, 659.25, 880];
        notes.forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'square';
            osc.frequency.value = freq;
            const startTime = audioCtx.currentTime + idx * 0.05;
            gain.gain.setValueAtTime(0.15, startTime);
            gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.15);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(startTime);
            osc.stop(startTime + 0.15);
        });
    }

    function playSplashSound() {
        if (!audioCtx) return;
        const now = audioCtx.currentTime;
        const bufferSize = audioCtx.sampleRate * 0.25;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
        }
        const noise = audioCtx.createBufferSource();
        noise.buffer = buffer;

        const noiseGain = audioCtx.createGain();
        noiseGain.gain.setValueAtTime(0.3, now);
        noiseGain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);

        noise.connect(noiseGain);
        noiseGain.connect(audioCtx.destination);
        noise.start(now);
    }

    function startGame() {
        initAudio();
        document.getElementById('start-menu-modal').classList.remove('active');
    }

    // ==========================================
    // 1. GAME STATE & VARIABLES
    // ==========================================
    let currentLevel = 1;
    let GRID_WIDTH = 6;
    let GRID_HEIGHT = 5;

    let gridLogic = [];
    let frogPos = {x: 0, z: 0};
    let startPos = {x: 0, z: 0};
    let commands = [];
    let isExecuting = false;

    let buttonBridges = [];
    let sceneObjects = [];
    let streamMeshes = [];
    let fountainObjects = [];
    let trophyObjects = [];
    let interactiveTiles = [];

    const PAIR_COLORS = [
        0xcc0000, 0xaa00aa, 0xccaa00, 0x00aaaa, 0xdd6600
    ];

    let active3DPointerId = null;
    let dragged3DObject = null;
    let dragged3DType = null;
    let dragged3DSourceElem = null;
    let draggedPlankSourceCell = null;
    
    let activeCardPointerId = null;
    let draggedCardIdx = null;

    const dragPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -0.5);

    // ==========================================
    // 2. THREE.JS FULL-SCREEN RETRO SETUP
    // ==========================================
    const wrapper = document.getElementById('game-wrapper');
    const container = document.getElementById('canvas-container');
    
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#336699');

    const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 250);

    const renderer = new THREE.WebGLRenderer({ antialias: false });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(0.65);
    container.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.85);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 0.4);
    dirLight.position.set(10, 20, 10);
    scene.add(dirLight);

    function adjustCameraToFitMap(w, h) {
        const aspect = window.innerWidth / window.innerHeight;
        const vFovRad = THREE.MathUtils.degToRad(camera.fov);

        const mapCenterX = (w - 1) / 2;
        const mapCenterZ = (h - 1) / 2;

        const shiftedCenterX = aspect > 1.2 ? mapCenterX - 1.2 : mapCenterX;

        const totalW = w + (aspect > 1.2 ? 6.5 : 4.0);
        const totalH = h + 5.5;

        const distH = (totalH / 2) / Math.tan(vFovRad / 2);
        const distW = (totalW / (2 * aspect)) / Math.tan(vFovRad / 2);

        const dist = Math.max(distH, distW);

        camera.position.set(shiftedCenterX, dist, mapCenterZ + 0.001);
        camera.lookAt(shiftedCenterX, 0, mapCenterZ);
        camera.aspect = aspect;
        camera.updateProjectionMatrix();
    }

    // ==========================================
    // 3. MATERIALS & RETRO 3D MODELS
    // ==========================================
    const matGrass = new THREE.MeshStandardMaterial({ color: 0x00aa00, flatShading: true });
    const matDirt = new THREE.MeshStandardMaterial({ color: 0x663300, flatShading: true });
    const matWater = new THREE.MeshStandardMaterial({ color: 0x0055aa, transparent: true, opacity: 0.85, flatShading: true });
    const matBoulder = new THREE.MeshStandardMaterial({ color: 0xaaaaaa, flatShading: true });
    const matButtonGreen = new THREE.MeshStandardMaterial({ color: 0x00ff00, flatShading: true });
    
    const matFrog = new THREE.MeshStandardMaterial({ color: 0x00cc00, flatShading: true });
    const geoBox = new THREE.BoxGeometry(0.94, 0.5, 0.94);
    const geoHalfBox = new THREE.BoxGeometry(0.94, 0.2, 0.94);

    // --- 8-BIT RETRO GOLD STAR 3D MESH GENERATOR ---
    function createStarMesh() {
        const group = new THREE.Group();
        const goldMat = new THREE.MeshStandardMaterial({ color: 0xffff00, flatShading: true });

        const shape = new THREE.Shape();
        const points = 5;
        const outerRadius = 0.28;
        const innerRadius = 0.13;

        for (let i = 0; i < points * 2; i++) {
            const r = (i % 2 === 0) ? outerRadius : innerRadius;
            const a = (i / (points * 2)) * Math.PI * 2 - Math.PI / 2;
            const x = Math.cos(a) * r;
            const y = Math.sin(a) * r;
            if (i === 0) shape.moveTo(x, y);
            else shape.lineTo(x, y);
        }
        shape.closePath();

        const extrudeSettings = {
            depth: 0.08,
            bevelEnabled: true,
            bevelSegments: 1,
            steps: 1,
            bevelSize: 0.03,
            bevelThickness: 0.03
        };

        const geo = new THREE.ExtrudeGeometry(shape, extrudeSettings);
        geo.center();
        const starMesh = new THREE.Mesh(geo, goldMat);
        starMesh.rotation.x = -Math.PI / 2;
        starMesh.position.y = 0.35;

        group.add(starMesh);
        return group;
    }

    function createBridgeMesh(accentColor = 0x8b5a2b) {
        const bridge = new THREE.Group();
        const matBeam = new THREE.MeshStandardMaterial({ color: accentColor, flatShading: true });
        const matSlat = new THREE.MeshStandardMaterial({ color: 0xcc9966, flatShading: true });

        const beamGeo = new THREE.BoxGeometry(0.12, 0.16, 0.92);
        const beamL = new THREE.Mesh(beamGeo, matBeam); beamL.position.set(-0.36, 0.08, 0);
        const beamR = new THREE.Mesh(beamGeo, matBeam); beamR.position.set(0.36, 0.08, 0);
        bridge.add(beamL, beamR);

        const slatGeo = new THREE.BoxGeometry(0.92, 0.08, 0.15);
        for (let i = 0; i < 5; i++) {
            const zPos = -0.36 + i * 0.18;
            const slat = new THREE.Mesh(slatGeo, matSlat);
            slat.position.set(0, 0.14, zPos);
            bridge.add(slat);
        }
        return bridge;
    }

    // --- 8-BIT RETRO STEPPING STONE PLATFORM MESH ---
    function createPlatformMesh() {
        const group = new THREE.Group();
        const matStoneDark = new THREE.MeshStandardMaterial({ color: 0x555555, flatShading: true });
        const matStoneLight = new THREE.MeshStandardMaterial({ color: 0x888888, flatShading: true });
        const matStoneTop = new THREE.MeshStandardMaterial({ color: 0xaaaaaa, flatShading: true });

        const baseGeo = new THREE.BoxGeometry(0.86, 0.15, 0.86);
        const baseMesh = new THREE.Mesh(baseGeo, matStoneDark);
        baseMesh.position.y = 0.08;
        group.add(baseMesh);

        const midGeo = new THREE.BoxGeometry(0.76, 0.12, 0.76);
        const midMesh = new THREE.Mesh(midGeo, matStoneLight);
        midMesh.position.y = 0.20;
        group.add(midMesh);

        const topGeo = new THREE.BoxGeometry(0.68, 0.08, 0.68);
        const topMesh = new THREE.Mesh(topGeo, matStoneTop);
        topMesh.position.y = 0.28;
        group.add(topMesh);

        return group;
    }

    // --- 8-BIT RETRO FOUNTAIN GENERATOR ---
    function createSplashFountain(x, z) {
        const group = new THREE.Group();

        const matStone = new THREE.MeshStandardMaterial({ color: 0x888888, flatShading: true });
        const matWaterCore = new THREE.MeshStandardMaterial({ color: 0x00ffff, flatShading: true, transparent: true, opacity: 0.8 });
        const matFoam = new THREE.MeshStandardMaterial({ color: 0xffffff, flatShading: true });

        const basinGeo = new THREE.CylinderGeometry(0.42, 0.42, 0.2, 8);
        const basin = new THREE.Mesh(basinGeo, matStone);
        basin.position.y = 0.1;
        group.add(basin);

        const poolGeo = new THREE.CylinderGeometry(0.38, 0.38, 0.05, 8);
        const pool = new THREE.Mesh(poolGeo, matWaterCore);
        pool.position.y = 0.18;
        group.add(pool);

        const pillarGeo = new THREE.CylinderGeometry(0.1, 0.14, 0.3, 6);
        const pillar = new THREE.Mesh(pillarGeo, matStone);
        pillar.position.y = 0.25;
        group.add(pillar);

        const jetGeo = new THREE.CylinderGeometry(0.08, 0.18, 0.5, 6);
        const jet = new THREE.Mesh(jetGeo, matWaterCore);
        jet.position.y = 0.55;
        jet.name = "jet";
        group.add(jet);

        const dropGeo = new THREE.BoxGeometry(0.06, 0.06, 0.06);
        const droplets = [];
        for (let i = 0; i < 8; i++) {
            const drop = new THREE.Mesh(dropGeo, matFoam);
            const angle = (i / 8) * Math.PI * 2;
            drop.userData = {
                baseAngle: angle,
                radius: 0.15 + Math.random() * 0.15,
                speed: 4 + Math.random() * 2,
                phase: Math.random() * Math.PI * 2
            };
            group.add(drop);
            droplets.push(drop);
        }
        group.userData = { droplets };

        group.position.set(x, 0, z);
        return group;
    }

    // Frog Model
    const frogGroup = new THREE.Group();
    const frogBody = new THREE.Mesh(new THREE.BoxGeometry(0.48, 0.38, 0.52), matFrog);
    frogBody.position.y = 0.41;
    
    const eyeGeo = new THREE.BoxGeometry(0.12, 0.12, 0.12);
    const eyeMat = new THREE.MeshStandardMaterial({ color: 0xffffff, flatShading: true });
    const pupilMat = new THREE.MeshStandardMaterial({ color: 0x000000, flatShading: true });
    
    const eyeL = new THREE.Mesh(eyeGeo, eyeMat); eyeL.position.set(-0.15, 0.58, 0.16);
    const pupilL = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, 0.06), pupilMat); pupilL.position.set(0, 0, 0.05);
    eyeL.add(pupilL);
    
    const eyeR = new THREE.Mesh(eyeGeo, eyeMat); eyeR.position.set(0.15, 0.58, 0.16);
    const pupilR = pupilL.clone(); eyeR.add(pupilR);

    frogGroup.add(frogBody, eyeL, eyeR);
    scene.add(frogGroup);

    // Fly Model
    const flyGroup = new THREE.Group();
    const flyBody = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.2, 0.2), new THREE.MeshStandardMaterial({color: 0x000000, flatShading: true}));
    const wingMat = new THREE.MeshStandardMaterial({color: 0xffffff, flatShading: true});
    
    const wing1 = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.04, 0.12), wingMat); wing1.position.set(0.15, 0.1, 0); wing1.name = "wing1";
    const wing2 = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.04, 0.12), wingMat); wing2.position.set(-0.15, 0.1, 0); wing2.name = "wing2";
    flyGroup.add(flyBody, wing1, wing2);
    scene.add(flyGroup);

    function createTurtle(x, z) {
        const group = new THREE.Group();
        const shell = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.25, 0.6), new THREE.MeshStandardMaterial({ color: 0x004400, flatShading: true }));
        shell.position.y = 0.2;
        group.add(shell);

        const head = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.18, 0.18), new THREE.MeshStandardMaterial({ color: 0x00aa00, flatShading: true }));
        head.position.set(0, 0.22, 0.35);
        group.add(head);

        group.position.set(x, 0, z);
        scene.add(group);
        sceneObjects.push(group);
    }

    function createTree(x, z) {
        const tree = new THREE.Group();
        const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.18, 0.7, 6), new THREE.MeshStandardMaterial({ color: 0x663300, flatShading: true }));
        trunk.position.y = 0.35;
        const leaves = new THREE.Mesh(new THREE.ConeGeometry(0.55, 1.1, 5), new THREE.MeshStandardMaterial({ color: 0x008800, flatShading: true }));
        leaves.position.y = 1.0;
        tree.add(trunk, leaves);
        tree.position.set(x, 0, z);
        scene.add(tree);
        sceneObjects.push(tree);
    }

    // ==========================================
    // 4. ADVANCED DYNAMIC MAP GENERATOR
    // ==========================================
    function getLineCells(p1, p2) {
        let lineCells = new Set();
        let steps = Math.max(Math.abs(p2.x - p1.x), Math.abs(p2.z - p1.z)) * 10 || 10;
        for (let i = 0; i <= steps; i++) {
            let t = i / steps;
            let x = Math.round(p1.x + t * (p2.x - p1.x));
            let z = Math.round(p1.z + t * (p2.z - p1.z));
            lineCells.add(`${x},${z}`);
        }
        let arr = [];
        lineCells.forEach(key => {
            let [x, z] = key.split(',').map(Number);
            arr.push({x, z});
        });
        return arr;
    }

    function findPathBetween(p1, p2, visitedSet, W, H) {
        let queue = [{ pos: p1, path: [p1] }];
        let visitedInSearch = new Set();
        visitedInSearch.add(`${p1.x},${p1.z}`);

        while (queue.length > 0) {
            queue.sort((a, b) => {
                let distA = Math.abs(a.pos.x - p2.x) + Math.abs(a.pos.z - p2.z) + Math.random() * 2;
                let distB = Math.abs(b.pos.x - p2.x) + Math.abs(b.pos.z - p2.z) + Math.random() * 2;
                return distA - distB;
            });

            let curr = queue.shift();
            if (curr.pos.x === p2.x && curr.pos.z === p2.z) return curr.path;

            let dirs = [{x: 1, z: 0}, {x: -1, z: 0}, {x: 0, z: 1}, {x: 0, z: -1}].sort(() => Math.random() - 0.5);

            for (let d of dirs) {
                let nx = curr.pos.x + d.x, nz = curr.pos.z + d.z;
                let key = `${nx},${nz}`;
                if (nx >= 0 && nx < W && nz >= 0 && nz < H && !visitedSet.has(key) && !visitedInSearch.has(key)) {
                    visitedInSearch.add(key);
                    queue.push({ pos: {x: nx, z: nz}, path: [...curr.path, {x: nx, z: nz}] });
                }
            }
        }
        return null;
    }

    function generateLevelData(level) {
        const W = level > 10 ? Math.max(7, Math.min(6 + Math.floor((level - 1) * 0.25), 8)) : Math.min(6 + Math.floor((level - 1) * 0.25), 8);
        const H = level > 10 ? Math.max(6, Math.min(5 + Math.floor((level - 1) * 0.2), 6)) : Math.min(5 + Math.floor((level - 1) * 0.2), 6);

        let map, fullPath, success = false;
        let attempts = 0;
        let startP, flyP;

        while (!success && attempts < 100) {
            attempts++;
            map = Array.from({ length: H }, () => Array(W).fill('~'));

            let archetype = Math.floor(Math.random() * 5);

            if (archetype === 0) {
                startP = { x: Math.floor(Math.random() * 2), z: H - 1 - Math.floor(Math.random() * 2) };
                flyP   = { x: W - 1 - Math.floor(Math.random() * 2), z: Math.floor(Math.random() * 2) };
            } else if (archetype === 1) {
                startP = { x: W - 1 - Math.floor(Math.random() * 2), z: H - 1 - Math.floor(Math.random() * 2) };
                flyP   = { x: Math.floor(Math.random() * 2), z: Math.floor(Math.random() * 2) };
            } else if (archetype === 2) {
                startP = { x: W - 1 - Math.floor(Math.random() * 2), z: Math.floor(Math.random() * 2) };
                flyP   = { x: Math.floor(Math.random() * 2), z: H - 1 - Math.floor(Math.random() * 2) };
            } else if (archetype === 3) {
                startP = { x: Math.floor(W / 2), z: Math.floor(H / 2) };
                let corners = [{x:0, z:0}, {x:W-1, z:0}, {x:0, z:H-1}, {x:W-1, z:H-1}];
                flyP   = corners[Math.floor(Math.random() * corners.length)];
            } else {
                startP = { x: Math.floor(Math.random() * 2), z: Math.floor(Math.random() * 2) };
                flyP   = { x: W - 1 - Math.floor(Math.random() * 2), z: H - 1 - Math.floor(Math.random() * 2) };
            }

            if (Math.abs(startP.z - flyP.z) < 2) continue;

            let mid1 = { x: (Math.random() < 0.5) ? 0 : W - 1, z: (Math.random() < 0.5) ? 0 : H - 1 };
            let mid2 = { x: Math.floor(Math.random() * W), z: Math.floor(Math.random() * H) };

            let waypoints = [startP, mid1, mid2, flyP].filter((wp, idx, arr) => idx === 0 || wp.x !== arr[idx-1].x || wp.z !== arr[idx-1].z);

            let visitedSet = new Set();
            fullPath = [];
            let failed = false;

            for (let i = 0; i < waypoints.length - 1; i++) {
                let subPath = findPathBetween(waypoints[i], waypoints[i+1], visitedSet, W, H);
                if (!subPath || subPath.length < 2) { failed = true; break; }
                for (let pt of subPath) {
                    let key = `${pt.x},${pt.z}`;
                    if (!visitedSet.has(key)) {
                        visitedSet.add(key);
                        fullPath.push(pt);
                    }
                }
            }

            if (!failed && fullPath.length >= 6 && fullPath.length <= 14) {
                success = true;
            }
        }

        if (!success || fullPath.length < 5) {
            startP = { x: 0, z: H - 1 };
            flyP   = { x: W - 1, z: 0 };
            fullPath = [];
            let curX = startP.x, curZ = startP.z;
            fullPath.push({ x: curX, z: curZ });

            while (curX !== flyP.x) { curX += (flyP.x > curX ? 1 : -1); fullPath.push({ x: curX, z: curZ }); }
            while (curZ !== flyP.z) { curZ += (flyP.z > curZ ? 1 : -1); fullPath.push({ x: curX, z: curZ }); }
        }

        let path = fullPath;
        map[path[0].z][path[0].x] = 'S';
        for (let i = 1; i < path.length - 1; i++) { map[path[i].z][path[i].x] = '.'; }
        map[path[path.length - 1].z][path[path.length - 1].x] = 'F';

        for (let z = 0; z < H; z++) {
            for (let x = 0; x < W; x++) {
                if (map[z][x] === '~' && Math.random() < 0.05) map[z][x] = '.';
            }
        }

        let candidates = [];
        for (let i = 2; i < path.length - 2; i++) candidates.push(i);
        candidates.sort(() => Math.random() - 0.5);

        let generatedBridges = [];
        let numBridges = Math.min(Math.floor((level - 1) / 3), 2);
        let numHoses = Math.min(Math.floor(level / 4), 1);
        let numGaps = Math.min(1 + Math.floor(level / 3), 3);

        let bridgeChars = ['=', '#', '$', '%'];
        let btnChars = ['O', 'P', 'Q', 'R'];

        let gapCount = 0;
        let hoseCount = 0;
        let usedCoords = new Set(path.map(p => `${p.x},${p.z}`));

        if (level > 10 && path.length > 3) {
            let lineCells = getLineCells(startP, flyP);
            let candidatesForStar = [];

            for (let z = 0; z < H; z++) {
                for (let x = 0; x < W; x++) {
                    let key = `${x},${z}`;
                    if (!usedCoords.has(key) && map[z][x] === '~') {
                        let minDistToLine = Infinity;
                        for (let lc of lineCells) {
                            let dist = Math.max(Math.abs(x - lc.x), Math.abs(z - lc.z));
                            if (dist < minDistToLine) minDistToLine = dist;
                        }

                        for (let i = 1; i < path.length - 1; i++) {
                            let pt = path[i];
                            let d = Math.abs(pt.x - x) + Math.abs(pt.z - z);
                            if (d === 1) {
                                candidatesForStar.push({ x, z, anchor: pt, minDistToLine, anchorIdx: i });
                                break;
                            }
                        }
                    }
                }
            }

            let validStarCandidates = candidatesForStar.filter(c => c.minDistToLine >= 2);
            if (validStarCandidates.length === 0) validStarCandidates = candidatesForStar;

            if (validStarCandidates.length > 0) {
                validStarCandidates.sort((a, b) => b.minDistToLine - a.minDistToLine || Math.random() - 0.5);
                let chosen = validStarCandidates[0];
                map[chosen.z][chosen.x] = 'T';
                usedCoords.add(`${chosen.x},${chosen.z}`);
                gapCount++;
            }
        }

        for (let b = 0; b < numBridges && candidates.length > 0; b++) {
            let bridgeIdx = candidates.pop();
            let brPos = path[bridgeIdx];

            let availablePrevIdxs = [];
            for (let i = 1; i < bridgeIdx; i++) availablePrevIdxs.push(i);

            let btnPlaced = false;
            let pairColor = PAIR_COLORS[b % PAIR_COLORS.length];

            if (availablePrevIdxs.length > 0) {
                availablePrevIdxs.sort(() => Math.random() - 0.5);

                for (let anchorIdx of availablePrevIdxs) {
                    let anchor = path[anchorIdx];
                    let dirs = [{x: 0, z: -1}, {x: 0, z: 1}, {x: -1, z: 0}, {x: 1, z: 0}].sort(() => Math.random() - 0.5);

                    for (let d of dirs) {
                        let buttonTile = { x: anchor.x + d.x, z: anchor.z + d.z };
                        let key = `${buttonTile.x},${buttonTile.z}`;

                        if (buttonTile.x >= 0 && buttonTile.x < W && buttonTile.z >= 0 && buttonTile.z < H && !usedCoords.has(key)) {
                            usedCoords.add(key);
                            map[buttonTile.z][buttonTile.x] = btnChars[b];
                            map[brPos.z][brPos.x] = bridgeChars[b];

                            generatedBridges.push({
                                id: b,
                                color: pairColor,
                                btnChar: btnChars[b],
                                bridgeChar: bridgeChars[b],
                                btnPos: { x: buttonTile.x, z: buttonTile.z },
                                bridgePos: { x: brPos.x, z: brPos.z },
                                open: false,
                                btnMesh: null,
                                bridgeMesh: null,
                                btnMat: null
                            });

                            btnPlaced = true;
                            break;
                        }
                    }
                    if (btnPlaced) break;
                }
            }

            if (!btnPlaced && availablePrevIdxs.length > 0) {
                let fallbackIdx = availablePrevIdxs[0];
                let btPos = path[fallbackIdx];
                map[brPos.z][brPos.x] = bridgeChars[b];
                map[btPos.z][btPos.x] = btnChars[b];

                generatedBridges.push({
                    id: b, color: pairColor, btnChar: btnChars[b], bridgeChar: bridgeChars[b],
                    btnPos: { x: btPos.x, z: btPos.z }, bridgePos: { x: brPos.x, z: brPos.z },
                    open: false, btnMesh: null, bridgeMesh: null, btnMat: null
                });
            }
        }

        for (let h = 0; h < numHoses && candidates.length > 0; h++) {
            let streamIdx = candidates.pop();
            let streamPos = path[streamIdx];
            map[streamPos.z][streamPos.x] = '|';
            hoseCount++;
        }

        for (let g = 0; g < numGaps && candidates.length > 0; g++) {
            let gapIdx = candidates.pop();
            let gapPos = path[gapIdx];
            map[gapPos.z][gapPos.x] = '~';
            gapCount++;
        }

        return { W, H, map, generatedBridges, gapCount, hoseCount, usedCoords };
    }

    function initLevel() {
        sceneObjects.forEach(obj => scene.remove(obj));
        sceneObjects = [];
        interactiveTiles = [];
        streamMeshes = [];
        fountainObjects = [];
        trophyObjects = [];
        gridLogic = [];

        document.getElementById('level-number-text').innerText = currentLevel;
        setStatus('frog');

        const levelData = generateLevelData(currentLevel);
        GRID_WIDTH = levelData.W;
        GRID_HEIGHT = levelData.H;
        buttonBridges = levelData.generatedBridges;

        commands = [];
        renderCards();

        adjustCameraToFitMap(GRID_WIDTH, GRID_HEIGHT);

        const MARGIN = 8;
        for (let z = -MARGIN; z < GRID_HEIGHT + MARGIN; z++) {
            for (let x = -MARGIN; x < GRID_WIDTH + MARGIN; x++) {
                if (x < 0 || x >= GRID_WIDTH || z < 0 || z >= GRID_HEIGHT) {
                    const dirtTile = new THREE.Mesh(geoBox, matDirt);
                    dirtTile.position.set(x, 0, z);
                    scene.add(dirtTile); sceneObjects.push(dirtTile);
                    if (Math.random() < 0.4) createTree(x, z);
                }
            }
        }

        let waterTiles = [];

        for (let z = 0; z < GRID_HEIGHT; z++) {
            let row = [];
            for (let x = 0; x < GRID_WIDTH; x++) {
                const char = levelData.map[z][x];
                let type = 'grass';
                let mesh;

                if (char === '~' || ['=','#','$','%'].includes(char) || char === '|' || char === 'T') {
                    mesh = new THREE.Mesh(geoHalfBox, matWater);
                    mesh.position.set(x, -0.15, z);
                    type = 'water';
                    if (char === '~' && !levelData.usedCoords.has(`${x},${z}`)) waterTiles.push({x, z});
                } else {
                    mesh = new THREE.Mesh(geoBox, matGrass);
                    mesh.position.set(x, 0, z);
                }
                
                scene.add(mesh); sceneObjects.push(mesh);

                const hitBox = new THREE.Mesh(new THREE.BoxGeometry(1, 1, 1), new THREE.MeshBasicMaterial({visible: false}));
                hitBox.position.set(x, 0.25, z);
                hitBox.userData = { x, z, char, type, accepts: '' };
                scene.add(hitBox); sceneObjects.push(hitBox); interactiveTiles.push(hitBox);

                if (char === 'S') { 
                    frogPos = {x, z}; 
                    startPos = {x, z}; 
                    setFrogPos(x, z); 
                    frogGroup.rotation.y = 0; 
                }
                if (char === 'F') { 
                    flyGroup.position.set(x, 0.6, z);
                    flyGroup.userData.baseX = x;
                    flyGroup.userData.baseZ = z;
                }

                let trophyMesh = null;
                if (char === 'T') {
                    trophyMesh = createStarMesh();
                    trophyMesh.position.set(x, 0.15, z);
                    scene.add(trophyMesh); sceneObjects.push(trophyMesh); trophyObjects.push(trophyMesh);
                }

                buttonBridges.forEach(bb => {
                    if (bb.btnPos.x === x && bb.btnPos.z === z) {
                        bb.btnMat = new THREE.MeshStandardMaterial({ color: bb.color, flatShading: true });
                        bb.btnMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 0.2, 12), bb.btnMat);
                        bb.btnMesh.position.set(x, 0.3, z);
                        scene.add(bb.btnMesh); sceneObjects.push(bb.btnMesh);
                    }
                    if (bb.bridgePos.x === x && bb.bridgePos.z === z) {
                        bb.bridgeMesh = createBridgeMesh(bb.color);
                        bb.bridgeMesh.position.set(x, -0.3, z);
                        scene.add(bb.bridgeMesh); sceneObjects.push(bb.bridgeMesh);
                    }
                });

                // ONLY ACCEPT PLANKS ON OPEN WATER GAPS (NOT FOUNTAINS)
                if (char === '~' || char === 'T') { hitBox.userData.accepts = 'plank'; }
                if (char === '|') { hitBox.userData.accepts = 'boulder'; }

                row.push({ char, type, hasPlank: false, hasBoulder: false, hasTurtle: false, x, z, plankMesh: null, hitBox, trophyMesh, trophyCollected: false });
            }
            gridLogic.push(row);
        }

        if (waterTiles.length > 0 && Math.random() < 0.7) {
            const spot = waterTiles[Math.floor(Math.random() * waterTiles.length)];
            createTurtle(spot.x, spot.z);
            gridLogic[spot.z][spot.x].hasTurtle = true;
        }

        const inventoryEl = document.getElementById('inventory');
        inventoryEl.innerHTML = '';
        for (let p = 0; p < levelData.gapCount; p++) {
            inventoryEl.innerHTML += `<div class="item" onpointerdown="startInventoryDrag(event, 'plank', 'plank${p}')" id="plank${p}">${PLANK_SVG}</div>`;
        }
        for (let b = 0; b < levelData.hoseCount; b++) {
            inventoryEl.innerHTML += `<div class="item" onpointerdown="startInventoryDrag(event, 'boulder', 'boulder${b}')" id="boulder${b}">${PLATFORM_SVG}</div>`;
        }

        updateHoseStream();
    }

    function setFrogPos(x, z) {
        frogGroup.position.set(x, 0, z);
    }

    function updateHoseStream() {
        streamMeshes.forEach(m => { scene.remove(m); });
        streamMeshes = [];
        fountainObjects = [];

        for (let z = 0; z < GRID_HEIGHT; z++) {
            for (let x = 0; x < GRID_WIDTH; x++) {
                if (gridLogic[z][x].char === '|') {
                    if (!gridLogic[z][x].hasBoulder) {
                        const fountain = createSplashFountain(x, z);
                        scene.add(fountain); sceneObjects.push(fountain);
                        streamMeshes.push(fountain); fountainObjects.push(fountain);
                    }
                }
            }
        }
    }

    // ==========================================
    // 5. KEYBOARD & ARROW BUILDER
    // ==========================================
    function addCard(dir) {
        if (isExecuting) return;
        initAudio();
        commands.push(dir);
        playJumpSound();
        renderCards();
    }

    function deleteLastCard() {
        if (isExecuting || commands.length === 0) return;
        initAudio();
        commands.pop();
        playJumpSound();
        renderCards();
    }

    function clearAllCards() {
        if (isExecuting || commands.length === 0) return;
        initAudio();
        commands = [];
        playJumpSound();
        renderCards();
    }

    // KEYBOARD LISTENER (WASD / ARROWS / ENTER / BKSP)
    window.addEventListener('keydown', (e) => {
        if (document.getElementById('start-menu-modal').classList.contains('active')) {
            if (e.key === 'Enter' || e.key === ' ') startGame();
            return;
        }
        if (document.getElementById('next-level-modal').classList.contains('active')) {
            if (e.key === 'Enter' || e.key === ' ') loadNextLevel();
            return;
        }

        if (isExecuting) return;

        const k = e.key;
        if (k === 'ArrowUp' || k === 'w' || k === 'W') addCard('UP');
        else if (k === 'ArrowDown' || k === 's' || k === 'S') addCard('DOWN');
        else if (k === 'ArrowLeft' || k === 'a' || k === 'A') addCard('LEFT');
        else if (k === 'ArrowRight' || k === 'd' || k === 'D') addCard('RIGHT');
        else if (k === 'Backspace' || k === 'Delete') deleteLastCard();
        else if (k === 'c' || k === 'C' || k === 'Escape') clearAllCards();
        else if (k === 'Enter' || k === ' ') executeCode();
        else if (k === 'r' || k === 'R') replayCurrentLevel();
        else if (k === 'l' || k === 'L') openLevelSelectModal();
    });

    // ==========================================
    // 6. CARD RENDERER
    // ==========================================
    function renderCards() {
        const container = document.getElementById('card-container');
        container.innerHTML = '';

        const cardClasses = { 'UP': 'card-up', 'DOWN': 'card-down', 'LEFT': 'card-left', 'RIGHT': 'card-right' };
        const numCards = commands.length;
        if (numCards === 0) return;

        const gap = 8;
        const cardSize = Math.max(28, Math.min(64, Math.floor((container.clientWidth - 40) / numCards)));

        container.style.gap = gap + 'px';

        commands.forEach((cmd, idx) => {
            const card = document.createElement('div');
            card.className = 'code-card ' + cardClasses[cmd];
            card.dataset.index = idx;

            card.style.width = cardSize + 'px';
            card.style.height = cardSize + 'px';

            card.innerHTML = `<span class="card-arrow" style="font-weight:bold; font-size: 16px;">${cmd[0]}</span>`;

            card.addEventListener('pointerdown', (e) => {
                if (isExecuting || activeCardPointerId !== null || active3DPointerId !== null) return;
                e.preventDefault();
                initAudio();

                activeCardPointerId = e.pointerId;
                draggedCardIdx = idx;
                card.classList.add('dragging');

                const onCardPointerUp = (upEvt) => {
                    if (upEvt.pointerId === activeCardPointerId) {
                        window.removeEventListener('pointerup', onCardPointerUp);
                        activeCardPointerId = null;
                        draggedCardIdx = null;
                        renderCards();
                    }
                };
                window.addEventListener('pointerup', onCardPointerUp);
            });

            container.appendChild(card);
        });
    }

    // ==========================================
    // 7. MOUSE DRAG & DROP FOR INVENTORY ITEMS
    // ==========================================
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    function startInventoryDrag(e, itemType, itemId) {
        if (isExecuting || active3DPointerId !== null) return;
        e.preventDefault();
        initAudio();

        const elem = document.getElementById(itemId);
        if (!elem) return;

        elem.style.display = 'none';

        if (itemType === 'plank') {
            dragged3DObject = createBridgeMesh();
        } else if (itemType === 'boulder') {
            dragged3DObject = createPlatformMesh();
        }

        active3DPointerId = e.pointerId;
        dragged3DType = itemType;
        dragged3DSourceElem = elem;

        scene.add(dragged3DObject);
        playJumpSound();
    }

    window.addEventListener('pointermove', (e) => {
        if (dragged3DObject && !isExecuting) {
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const targetPos = new THREE.Vector3();
            if (raycaster.ray.intersectPlane(dragPlane, targetPos)) {
                dragged3DObject.position.set(targetPos.x, 0.5, targetPos.z);
            }
        }
    });

    const handlePointerRelease = (e) => {
        if (dragged3DObject && !isExecuting) {
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveTiles);

            let droppedSuccessfully = false;

            if (intersects.length > 0) {
                const hit = intersects[0].object.userData;
                const targetCell = gridLogic[hit.z][hit.x];

                if (dragged3DType === 'plank') {
                    // DISALLOW PLANKS ON FOUNTAINS (|)
                    if (targetCell && targetCell.type === 'water' && targetCell.char !== '|' && !targetCell.hasPlank && !targetCell.hasBoulder) {
                        targetCell.hasPlank = true;
                        targetCell.plankMesh = dragged3DObject;
                        dragged3DObject.position.set(targetCell.x, 0.05, targetCell.z);
                        sceneObjects.push(dragged3DObject);
                        playBridgeSound();
                        droppedSuccessfully = true;
                    }
                } else if (dragged3DType === 'boulder') {
                    // STONE PLATFORM TARGETS FOUNTAINS ONLY
                    if (hit.accepts === 'boulder' && targetCell && !targetCell.hasBoulder) {
                        targetCell.hasBoulder = true;
                        dragged3DObject.position.set(targetCell.x, 0.0, targetCell.z);
                        sceneObjects.push(dragged3DObject);
                        updateHoseStream();
                        playBridgeSound();
                        droppedSuccessfully = true;
                    }
                }
            }

            if (!droppedSuccessfully) {
                if (dragged3DSourceElem) dragged3DSourceElem.style.display = 'flex';
                scene.remove(dragged3DObject);
            }

            active3DPointerId = null;
            dragged3DObject = null;
            dragged3DType = null;
            dragged3DSourceElem = null;
        }
    };

    window.addEventListener('pointerup', handlePointerRelease);

    // ==========================================
    // 8. EXECUTION ENGINE WITH FROG DIRECTION ROTATION
    // ==========================================
    function setStatus(type) {
        const el = document.getElementById('status-message');
        el.innerText = STATUS_ICONS[type] || type;
    }

    let animState = { active: false, startX: 0, startZ: 0, endX: 0, endZ: 0, progress: 0, dead: false };

    async function executeCode() {
        initAudio();
        if (isExecuting || commands.length === 0) return;
        isExecuting = true;
        setStatus('rocket');

        frogPos = {x: startPos.x, z: startPos.z};
        setFrogPos(frogPos.x, frogPos.z);
        frogGroup.rotation.y = 0;

        buttonBridges.forEach(bb => {
            bb.open = false;
            if (bb.btnMesh) bb.btnMesh.material = bb.btnMat;
            if (bb.bridgeMesh) bb.bridgeMesh.position.y = -0.3;
        });

        const cardContainer = document.getElementById('card-container');

        for (let i = 0; i < commands.length; i++) {
            const cardElems = Array.from(cardContainer.children);
            cardElems.forEach(el => el.classList.remove('executing'));
            if (cardElems[i]) cardElems[i].classList.add('executing');

            let cmd = commands[i];
            let nextX = frogPos.x;
            let nextZ = frogPos.z;

            // ROTATE FROG TO FACE JUMP DIRECTION
            if (cmd === 'UP') { nextZ--; frogGroup.rotation.y = Math.PI; }
            if (cmd === 'DOWN') { nextZ++; frogGroup.rotation.y = 0; }
            if (cmd === 'LEFT') { nextX--; frogGroup.rotation.y = -Math.PI / 2; }
            if (cmd === 'RIGHT') { nextX++; frogGroup.rotation.y = Math.PI / 2; }

            playJumpSound();
            await playJumpAnimation(frogPos.x, frogPos.z, nextX, nextZ);
            frogPos = {x: nextX, z: nextZ};

            if (frogPos.x < 0 || frogPos.x >= GRID_WIDTH || frogPos.z < 0 || frogPos.z >= GRID_HEIGHT) {
                setStatus('crash');
                break;
            }

            const cell = gridLogic[frogPos.z][frogPos.x];

            buttonBridges.forEach(bb => {
                if (bb.btnPos.x === frogPos.x && bb.btnPos.z === frogPos.z && !bb.open) {
                    bb.open = true;
                    bb.btnMesh.material = matButtonGreen;
                    bb.bridgeMesh.position.y = 0.05;
                    playBridgeSound();
                }
            });

            let dead = false;
            if (cell.type === 'water') {
                let isSafe = false;
                if (cell.hasPlank) isSafe = true;
                else if (cell.hasBoulder && cell.char === '|') isSafe = true;
                else {
                    buttonBridges.forEach(bb => {
                        if (cell.char === bb.bridgeChar && bb.open) isSafe = true;
                    });
                }
                if (!isSafe) dead = true;
            }

            if (dead) {
                setStatus('splash');
                playSplashSound();
                break;
            }

            if (cell.char === 'T' && cell.trophyMesh && !cell.trophyCollected) {
                cell.trophyCollected = true;
                scene.remove(cell.trophyMesh);
                playTrophySound();
                setStatus('star');
            }

            if (cell.char === 'F') {
                setStatus('win');
                playWinSound();
                showNextLevelModal();
                isExecuting = false;
                Array.from(cardContainer.children).forEach(el => el.classList.remove('executing'));
                return;
            }
        }

        Array.from(cardContainer.children).forEach(el => el.classList.remove('executing'));
        isExecuting = false;
    }

    function playJumpAnimation(sx, sz, ex, ez) {
        return new Promise(resolve => {
            animState = { active: true, startX: sx, startZ: sz, endX: ex, endZ: ez, progress: 0 };
            const check = setInterval(() => {
                if (!animState.active) {
                    clearInterval(check);
                    resolve();
                }
            }, 40);
        });
    }

    // ==========================================
    // 9. MODALS
    // ==========================================
    function showNextLevelModal() {
        document.getElementById('next-level-modal').classList.add('active');
    }
    function hideNextLevelModal() {
        document.getElementById('next-level-modal').classList.remove('active');
    }
    function openLevelSelectModal() {
        hideNextLevelModal();
        renderLevelGrid();
        document.getElementById('level-select-modal').classList.add('active');
    }
    function hideLevelSelectModal() {
        document.getElementById('level-select-modal').classList.remove('active');
    }
    function selectLevel(lvl) {
        currentLevel = lvl;
        hideLevelSelectModal();
        initLevel();
    }
    function renderLevelGrid() {
        const gridContainer = document.getElementById('level-grid-container');
        gridContainer.innerHTML = '';
        for (let i = 1; i <= 20; i++) {
            const btn = document.createElement('button');
            btn.className = 'level-btn' + (i === currentLevel ? ' active-level' : '');
            btn.innerText = i;
            btn.onclick = () => selectLevel(i);
            gridContainer.appendChild(btn);
        }
    }
    function replayCurrentLevel() {
        hideNextLevelModal();
        initLevel();
    }
    function loadNextLevel() {
        hideNextLevelModal();
        currentLevel++;
        initLevel();
    }

    // ==========================================
    // 10. ANIMATION LOOP & RESIZE HANDLER
    // ==========================================
    const clock = new THREE.Clock();
    
    function animate() {
        requestAnimationFrame(animate);
        const dt = clock.getDelta();
        const time = clock.getElapsedTime();

        // 1. ANIMATE FLY (Hovering, Wing Flapping, Jitter Buzzing)
        if (flyGroup) {
            const bx = flyGroup.userData.baseX || 0;
            const bz = flyGroup.userData.baseZ || 0;

            flyGroup.position.y = 0.6 + Math.sin(time * 8) * 0.08;
            flyGroup.position.x = bx + Math.sin(time * 5) * 0.04;
            flyGroup.position.z = bz + Math.cos(time * 6) * 0.04;

            const w1 = flyGroup.getObjectByName("wing1");
            const w2 = flyGroup.getObjectByName("wing2");
            if (w1 && w2) {
                w1.rotation.z = Math.sin(time * 45) * 0.35;
                w2.rotation.z = -Math.sin(time * 45) * 0.35;
            }
        }

        // 2. ROTATE GOLD STARS
        trophyObjects.forEach(t => {
            t.rotation.y += dt * 2.5;
        });

        // 3. ANIMATE FOUNTAIN SPRAY & JET
        fountainObjects.forEach(fountain => {
            const jet = fountain.getObjectByName("jet");
            if (jet) {
                jet.scale.set(
                    1 + Math.sin(time * 8) * 0.15,
                    1 + Math.cos(time * 10) * 0.2,
                    1 + Math.sin(time * 8) * 0.15
                );
            }
            if (fountain.userData.droplets) {
                fountain.userData.droplets.forEach(d => {
                    const t = time * d.userData.speed + d.userData.phase;
                    const r = d.userData.radius * (0.5 + 0.5 * Math.sin(t));
                    d.position.x = Math.cos(d.userData.baseAngle) * r;
                    d.position.z = Math.sin(d.userData.baseAngle) * r;
                    d.position.y = 0.45 + Math.abs(Math.sin(t)) * 0.35;
                });
            }
        });

        // 4. FROG JUMP ANIMATION
        if (animState.active) {
            animState.progress += dt * 3.5;
            if (animState.progress >= 1) {
                animState.progress = 1;
                animState.active = false;
            }
            frogGroup.position.x = THREE.MathUtils.lerp(animState.startX, animState.endX, animState.progress);
            frogGroup.position.z = THREE.MathUtils.lerp(animState.startZ, animState.endZ, animState.progress);
            frogGroup.position.y = Math.sin(animState.progress * Math.PI) * 0.6;
        }

        renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
        renderer.setSize(window.innerWidth, window.innerHeight);
        adjustCameraToFitMap(GRID_WIDTH, GRID_HEIGHT);
        renderCards();
    });

    initLevel();
    animate();
</script>
</body>
</html>